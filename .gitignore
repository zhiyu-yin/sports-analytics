# Historical NBA response fixtures outside data/: retain provenance, not payloads
/basketball/nba/game-prediction/docs/stage0_evidence/recorded_*.json
/basketball/nba/game-prediction/docs/stage0_evidence/live_*.txt

# Post-commit local receipt avoids a commit-hash self-reference
/basketball/nba/game-prediction/docs/stage8_evidence/local_release_receipt.json

# Derived evaluation datasets also exist under replay evidence folders
*.parquet

